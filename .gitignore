# OS junk
.DS_Store
Thumbs.db

# Build output and extracted/generated data (derived from your local ROM - never commit)
/build/
*.elf
*.map
/translations/*.bin
/tools/agbcc/
/tools/include/
/tools/lib/
/tools/bin/

# Emulator save data from testing - never commit
*.sav
*.sav.bak
*.ss0
*.ss1
*.ss2
*.ss3
*.ss4
*.ss5
*.ss6
*.ss7
*.ss8
*.ss9
__pycache__/

# The simulator's raw run dump (tools/quickstart/sim.py --out); 20 MB per
# 10,000 runs. The report and charts it feeds are committed instead.
docs/sim_runs.json

